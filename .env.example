PORT=8080
DATABASE_URL=postgres://relay:relay@localhost:5435/relay?sslmode=disable
LOG_LEVEL=info

# live | test — API keys are prefixed rly_live_ or rly_test_
RELAY_ENV=test

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/oauth/google/callback

# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

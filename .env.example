PORT=8080
DATABASE_URL=postgres://relay:relay@localhost:5435/relay?sslmode=disable
LOG_LEVEL=info

# live | test — API keys are prefixed rly_live_ or rly_test_
RELAY_ENV=test

# Providers: configure at least one. A provider is enabled when its CLIENT_ID or
# CLIENT_SECRET is set, and then all its variables are validated.

# Google OAuth: see docs/google-cloud-setup.md
# (Google Cloud Console > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/oauth/google/callback

# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Microsoft (Outlook / Graph): see docs/microsoft-setup.md
# CLIENT_ID = "Application (client) ID"; CLIENT_SECRET = the secret's Value (not its Secret ID).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL=http://localhost:8080/v1/oauth/microsoft/callback
# common = work/school + personal accounts | organizations | consumers | directory GUID | domain
MICROSOFT_TENANT_ID=common
# Optional, YYYY-MM-DD: the client secret's expiry. Startup fails after it and warns 30 days before.
MICROSOFT_EXPIRATION_DATE=

# Background token refresh. Both optional.
# REFRESH_AHEAD: renew access tokens this early (default 10m).
# REFRESH_CONCURRENCY: provider refresh calls in flight (default 8).
REFRESH_AHEAD=10m
REFRESH_CONCURRENCY=8

# Calendar push. Leave WEBHOOK_BASE_URL empty to stay on polling.
# When set, it must be the public https origin providers will call
# (http://127.0.0.1 is allowed for local tests) and NATS_URL is required.
# NATS_URL on its own enables delta sync and is dialed at startup.
# Leave it empty to keep sync off. Compose sets nats://nats:4222.
WEBHOOK_BASE_URL=
NATS_URL=
